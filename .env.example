# OpenAI-compatible LLM settings; copy to .env and fill in real keys locally only.
# Defaults match config.py (DeepSeek); to use another service, change all three and set
# LLM_THINKING back to auto.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60.0
# Whether LLM requests use the system proxy (HTTP(S)_PROXY). Default false; set true when
# outbound traffic must go through a proxy.
LLM_TRUST_ENV=false
# Whether the thinking switch is sent to an OpenAI-compatible service. auto = do not send it
# (keep the server default, thinking is on by default on DeepSeek); enabled/disabled forces it
# on or off. DeepSeek defaults to disabled; non-DeepSeek services must use auto, otherwise the
# request may fail with HTTP 400.
LLM_THINKING=disabled

# Local embedding, chunking, context and storage settings.
EMBEDDING_MODEL=BAAI/bge-m3
SOURCE_DOCS_PATH=data/source_docs
CHUNK_SIZE=512
# Used by the fixed strategy only; the hybrid strategy freezes window overlap at 0 (PH1 semantics).
CHUNK_OVERLAP=64
# Chunking strategy (promoted in Phase 13F): hybrid = structural parsing + hybrid splitting;
# fixed = the original fixed window (rollback option).
CHUNK_STRATEGY=hybrid
MAX_CONTEXT_TOKENS=4096
RERANKER_MODEL=BAAI/bge-reranker-base
# Defaults 50 -> 8 (previously 20 -> 5, then 50 -> 6; measured on rag_e2e_v1).
RERANKER_INPUT_K=50
# Keep in sync with config.py: raising 6 -> 8 was measured at +6 groups on 207 cases
# (paired bootstrap CI [+2,+11], p=0.0028). A stale value here silently reverts that.
RERANKER_FINAL_K=8
RERANKER_BATCH_SIZE=4
RERANKER_MAX_LENGTH=512
RERANKER_DTYPE=float32
# 默认保留整题席位，再按子问题与整题逆名次合并；可用 clause_first 或 original_first 对照。
# CLAUSE_BRANCH_FUSION_ORDER=rank_aware
# 双题项在可定向或可用词项召回时，从整题分支借出配额。关闭时可对照原分配。
# CLAUSE_BRANCH_BALANCE_TWO_PART_QUERIES=false
# 可选论文检索增强。仅在配置语料清单时加载英文论文子句专用的 MiniLM 重排器。
# CLAUSE_BRANCH_PAPER_MANIFEST=evals/research_ingestion/academic_corpus_manifest_v1.json
# 使用已有论文别名，给明确点名的双论文分别分配候选，配额内保留整题分支；默认关闭。
# CLAUSE_BRANCH_PARALLEL_PAPERS=true
# 试验开关：从唯一的 PDF 文件名识别点名查询，无需为新资料更新语料清单。
# CLAUSE_BRANCH_FILE_ALIASES=true
# 常规非 CJK 单句保留 Dense 候选，并在整题上限内追加少量 BM25 命中；默认关闭。
# CLAUSE_BRANCH_SINGLE_QUERY_BM25=true
# 固定候选池对照：仅在评分输入中加文档名和章节。
# RERANKER_USE_DOCUMENT_CONTEXT=true
# 基础 Dense 路径的名次融合；0 沿用 Cross-Encoder 排序，staging 对照可用 0.4。
RERANKER_DENSE_RRF_WEIGHT=0.0
# Inference device shared by the embedding model and the Reranker: auto | cpu | cuda.
MODEL_DEVICE=auto
VECTOR_DB_PATH=data/chroma
INDEX_STATE_PATH=artifacts/phase15a/index_state.json
# Usually left unset; the lifecycle active pointer is authoritative (INDEX_STATE_PATH points at
# the state file). If set explicitly and inconsistent with the active pointer, production
# refuses to start; it only acts as a fallback in a fresh environment with no state file.
# COLLECTION_NAME=ef_research_bge_m3_hybrid_c512_v2

# 证据 Agent 的预算。LLM 总上限包含决策、生成与一次格式修复，后两者预留 2 次。
AGENT_ADAPTIVE_LLM_CALLS_MAX=5
AGENT_ADAPTIVE_DECISION_CALLS_MAX=3
# 包含首轮原问题检索；可配置为 1–3 次，默认允许一次改写。
AGENT_ADAPTIVE_SEARCHES_MAX=2
AGENT_ADAPTIVE_OPENS_MAX=2
# 多子问题分支摘要和同文档前页补读，先在 staging 对照。
AGENT_ADAPTIVE_TARGETED_EVIDENCE=false
# Each real search is charged its production per-search reranker-pair upper bound.
AGENT_ADAPTIVE_RERANK_PAIRS_MAX=200
# 每次 LLM 传输和重试使用本题剩余时间，同步执行中的步骤不能被强制截断。
AGENT_ADAPTIVE_DEADLINE_SECONDS=20.0
# 三次检索实验：SEARCHES_MAX=3、DECISION_CALLS_MAX=5、LLM_CALLS_MAX=7、RERANK_PAIRS_MAX=300
# 以上均使用 AGENT_ADAPTIVE_ 前缀；300 对适用于默认的每次搜索 100 对上界。

# FastAPI 每进程执行与排队上限，超出容量或排队超时均返回 HTTP 503。
API_MAX_CONCURRENT_REQUESTS=1
API_MAX_QUEUED_REQUESTS=4
API_QUEUE_TIMEOUT_SECONDS=5.0
